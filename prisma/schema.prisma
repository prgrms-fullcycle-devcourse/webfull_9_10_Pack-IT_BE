generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int           @id @default(autoincrement())
  email          String?       @unique
  kakaoUid       String?       @unique @map("kakao_uid")
  nickname       String?
  createdAt      DateTime      @default(now()) @map("created_at")
  lastAccessedAt DateTime      @default(now()) @map("last_accessed_at")
  nanoId         String        @unique @map("nano_id")
  userType       String        @default("GUEST") @map("user_type")
  sentLetters    Letter[]      @relation("SentLetters")
  savedLetters   SavedLetter[] @relation("UserSavedLetters")

  @@map("user")
}

model Letter {
  id           String        @id @default(uuid())
  senderId     Int           @map("sender_id")
  senderName   String        @map("sender_name")
  receiverName String        @map("receiver_name")
  category     String
  content      String
  theme        Int
  publishedAt  DateTime      @default(now()) @map("published_at")
  password     String?
  sender       User          @relation("SentLetters", fields: [senderId], references: [id])
  savedRecords SavedLetter[] @relation("LetterSavedRecords")

  @@map("letter")
}

model SavedLetter {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  letterId String @map("letter_id")
  letter   Letter @relation("LetterSavedRecords", fields: [letterId], references: [id])
  user     User   @relation("UserSavedLetters", fields: [userId], references: [id])

  @@map("saved_letter")
}
